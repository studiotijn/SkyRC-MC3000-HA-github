# Copy this to secrets.yaml (gitignored) and fill in real values.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"
api_key: "base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="  # generate a real one, e.g. `openssl rand -base64 32`
ota_password: "change-me"

# BLE MAC address of the MC3000
mc3000_mac: "00:00:00:00:00:00"
